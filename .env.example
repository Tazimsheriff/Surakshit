# Server
PORT=4000
# Comma-separated browser origins. Use the Vite dev origin locally.
CORS_ORIGIN=http://localhost:5173
# Set to true only when the API sits behind a trusted reverse proxy.
TRUST_PROXY=false
RATE_LIMIT_MAX=30

# Optional AI explanations. Leave blank to use rules only.
# Credentials stay on the server. Do not put this key in any VITE_ variable.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=8000

# Optional Supabase persistence for anonymized analytics.
# Use the service role key only on the server. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend
# Leave empty in local dev so Vite proxies /api to the server.
# In production, set this to the public API origin, for example https://api.example.com
VITE_API_BASE_URL=
